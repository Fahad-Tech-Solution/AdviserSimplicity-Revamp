# Shared defaults — mode-specific values live in .env.development / .env.production
# Local development: leave VITE_API_BASE_URL empty and the app uses /dev_api.
# Production: set VITE_API_BASE_URL to the real API host if needed; the app auto-uses /api.
# Optional override: VITE_API_PATH=/api
# VITE_API_BASE_URL=http://localhost:7000
# VITE_API_BASE_URL=http://192.168.18.128:7000
VITE_API_BASE_URL=
